{
	frankenphp
	order php_server before file_server
}

:8080 {
	root * /app/public
	encode zstd br gzip

	php_server
	file_server

	# Serve Vite assets and images directly
	@static {
		file
		path *.css *.js *.png *.jpg *.jpeg *.gif *.svg *.ico *.woff *.woff2 *.ttf *.webp *.avif
	}
	header @static Cache-Control "public, max-age=31536000, immutable"
}
